@using BTCPayServer.Client
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using BTCPayServer.Abstractions.Contracts
@using BTCPayServer.Plugins.Boltz
@using BTCPayServer.Plugins.Boltz.Views
@inject IScopeProvider ScopeProvider
@inject BoltzService BoltzService
@{
    var storeId = ScopeProvider.GetCurrentStoreId();
    var pages = new List<BoltzNavPages> { BoltzNavPages.Configuration, BoltzNavPages.Swaps,
BoltzNavPages.Admin, BoltzNavPages.Wallets };
    if (BoltzService.IsStoreReadonly(storeId))
    {
        pages.Add(BoltzNavPages.Payouts);
    }
}

@if (!string.IsNullOrEmpty(storeId))
{
    <ul class="navbar-nav">
        <li class="nav-item">
            <a permission="@Policies.CanViewStoreSettings" asp-controller="Boltz" asp-action="Status"
                asp-route-storeId="@storeId" class="nav-link @ViewData.ActivePageClass(BoltzNavPages.Status)">
                <svg viewBox="0 0 78 78" version="1.1" xmlns="http://www.w3.org/2000/svg"
                    xmlns:xlink="http://www.w3.org/1999/xlink" style="padding: 2px" class="icon">
                    <g id="Logo" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                        <g id="Group">
                            <circle id="Oval" stroke="currentColor" stroke-width="6" cx="39" cy="39" r="36"></circle>
                            <circle id="RoutingRing" stroke="currentColor" stroke-width="3" stroke-dasharray="4 5" fill="none" cx="39" cy="39" r="26"></circle>
                            <path id="Bolt" d="M46,13 L24,43 L36,43 L32,65 L54,35 L42,35 Z" fill="currentColor"></path>
                        </g>
                    </g>
                </svg>
                <span>SatsRouting</span>
            </a>
        </li>
        @if (BoltzService.StoreConfigured(storeId) && (ViewData.IsPageActive([BoltzNavPages.Status]) ||
            ViewData.IsPageActive(pages)))
        {
            @foreach (var current in pages)
            {
                <li class="nav-item nav-item-sub">
                    <a permission="@(current == BoltzNavPages.Admin ? Policies.CanModifyServerSettings : Policies.CanViewStoreSettings)"
                        asp-controller="Boltz" asp-action="@current" asp-route-storeId="@storeId"
                        class="nav-link @ViewData.ActivePageClass(current)">
                        @current
                    </a>
                </li>
            }
        }
    </ul>
}